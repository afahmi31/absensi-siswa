{
  "name": "lab002-website-absensi-siswa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=10.9.3 <11"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "reproduce": "npm ci",
    "dev": "nuxt dev --host 127.0.0.1",
    "typecheck": "nuxt typecheck --checker vue-tsc",
    "build": "nuxt build --preset vercel",
    "build:node": "nuxt build --preset node-server",
    "start:node": "node scripts/start-node.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:migrate": "node scripts/db-migrate.mjs up",
    "db:supabase:migrate": "node scripts/supabase-migrate.mjs",
    "db:smoke": "node scripts/db-smoke.mjs",
    "db:rollback": "node scripts/db-migrate.mjs down",
    "test:data": "node scripts/test-data.mjs",
    "auth:account:provision": "node scripts/auth-account.mjs provision",
    "auth:account:reset": "node scripts/auth-account.mjs reset",
    "test:auth": "node scripts/test-auth.mjs",
    "test:students": "node scripts/test-students.mjs",
    "test:calendar": "node scripts/test-calendar.mjs",
    "test:attendance": "node scripts/test-attendance.mjs",
    "test:reports": "node scripts/test-reports.mjs",
    "test": "node scripts/test-all.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@adonisjs/hash": "9.1.1",
    "nuxt": "4.6.1",
    "nuxt-auth-utils": "0.5.31",
    "postgres": "3.4.9",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  }
}
